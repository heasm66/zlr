        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>Debugging support for ZLR.</description>
        <summary />
        <copyright>Copyright 2007-2016 Jesse McGrew</copyright>
        <language>en-US</language>
        <tags>zlr z-machine zmachine z-code zcode infocom jit interpreter debug debugger</tags>
        <dependencies>
            <group targetFramework=".NETFramework4.5.1">
                <dependency id="ZLR.VM" version="0.08" />
                <dependency id="Antlr4.Runtime" version="4.3.0" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="bin\Release\ZLR.Debugging.dll" target="lib\net451\ZLR.Debugging.dll" />
        <file src="bin\Release\ZLR.Debugging.pdb" target="lib\net451\ZLR.Debugging.pdb" />
    </files>
</package>